{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ster.invalid/schemas/factory/1",
  "title": "Ster factory definition (.ster/factory.yaml)",
  "description": "How agents are used on one project. Untrusted until the user trusts it for the folder; never overrides organization policy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "agents": {
      "description": "Agents the project uses.",
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } }
          },
          {
            "description": "Agent declared by start command. Requires user confirmation before first start.",
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "command"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "command": { "type": "string", "minLength": 1 },
              "args": { "type": "array", "items": { "type": "string" } },
              "env": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          }
        ]
      }
    },
    "defaultAgent": { "description": "Id or name of an entry in agents.", "type": "string" },
    "permissionMode": { "description": "Default permission mode for sessions in this project.", "type": "string" },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "prompt"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "prompt": { "description": "Request text. {{name}} marks a blank filled from inputs.", "type": "string" },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "label"],
              "properties": {
                "name": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
                "label": { "type": "string" },
                "default": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "judging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criteria"],
      "properties": {
        "scale": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "min": { "type": "number", "default": 0 }, "max": { "type": "number", "default": 10 } }
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "description"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
              "description": { "type": "string" },
              "weight": { "type": "number", "exclusiveMinimum": 0, "default": 1 }
            }
          }
        }
      }
    }
  }
}
